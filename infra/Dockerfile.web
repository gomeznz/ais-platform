# Builds the dashboard and serves it as static files via nginx.
# Built from the monorepo root: docker build -f infra/Dockerfile.web
#   --build-arg VITE_API_URL=https://your-api-domain --build-arg VITE_WS_URL=wss://your-api-domain .
#
# VITE_API_URL/VITE_WS_URL are baked in at build time (standard Vite
# behavior) — set them as build-time variables in Railway for the web
# service, not runtime env vars.
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}

COPY . .
RUN npm install
RUN npm run build -w apps/web

FROM nginx:1.27-alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
