DATABASE_URL=postgres://postgres:postgres@localhost:5432/ais

# Terrestrial: dial out to feeders speaking raw NMEA/AIVDM over TCP
# TCP_FEEDS=receiver1.example.com:5631,receiver2.example.com:5631

# Terrestrial: accept inbound connections from receivers that push to us
# TCP_LISTEN_PORT=5631

# Terrestrial/aggregator: accept AIVDM over UDP
# UDP_LISTEN_PORT=5632

# Satellite/aggregator: generic HTTP polling adapter (customize parseResponse
# in src/adapters/httpPollingAdapter.ts for your provider's JSON schema)
# SATELLITE_HTTP_URL=https://api.example-satellite-provider.com/v1/positions
# SATELLITE_HTTP_TOKEN=your-api-token
# SATELLITE_POLL_INTERVAL_MS=15000

# Local dev / demo: synthetic moving vessels so the live map has data when
# no real feed is configured. Runs automatically if no other source is set.
# MOCK_REPLAY=true
# MOCK_REPLAY_INTERVAL_MS=3000
